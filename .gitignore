!scripts/foundation/collectPersonalData.sh
!scripts/foundation/infoMatcher.sh
!scripts/foundation/installDependencies.sh
!scripts/foundation/pullOllamaModels.sh
!scripts/foundation/resumeBuilder.sh
!scripts/foundation/selectModel.sh
!scripts/foundation/startOpencodeServer.sh
!scripts/wrapper/
!scripts/wrapper/generateResume.sh
!scripts/wrapper/testScript.sh